# ==========================================
# REPOSITORIO DE GITHUB (ACTUALIZACIONES AUTOMÁTICAS)
# ==========================================
# Única configuración requerida para el sistema de actualizaciones.
# El launcher consultará el manifiesto en tu rama principal:
# https://raw.githubusercontent.com/{Username}/{RepositoryName}/refs/heads/main/...
# y descargará los paquetes .zip desde los Releases de este repositorio.
GITHUB_REPOSITORY_URL=https://github.com/tu-usuario/tu-repo

# ==========================================
# CLAVE DE ACCESO DEL CREADOR (CREATOR STUDIO)
# ==========================================
# PIN para desbloquear el panel visual de creación y empaquetado de actualizaciones
# (por defecto: 1234)
CREATOR_PIN=1234

# ==========================================
# MODLOADER (FABRIC / FORGE / NEOFORGE)
# ==========================================

# Tipo de modloader a utilizar:
# Opciones disponibles: FORGE, NEOFORGE o FABRIC
MOD_LOADER=FORGE

# Versión del modloader:
# - Escribe la versión específica si deseas fijarla (ej. 47.2.20, 20.4.253, 0.16.10)
# - O déjalo VACÍO para que el launcher detecte y descargue automáticamente la ÚLTIMA versión
MOD_LOADER_VERSION=

# ==========================================
# CONFIGURACIÓN DEL JUEGO
# ==========================================

# Nombre del modpack (aparece en el launcher)
MODPACK_NAME=Mi Modpack

# Versión de Minecraft
MINECRAFT_VERSION=1.20.1

# Versión de Java a instalar (Adoptium/Eclipse Temurin)
JAVA_VERSION=21

# Memoria RAM asignada al juego
RAM_MIN=2G
RAM_MAX=4G

# ==========================================
# AVANZADO - URLs DE DESCARGA DIRECTA (OPCIONAL)
# ==========================================

# Forzar URL específica del instalador del modloader (opcional)
# Si está vacío, se calcula automáticamente desde el repositorio Maven oficial
FORGE_INSTALLER_URL=

# Forzar URL específica de Java (opcional)
# Si está vacío, usa Adoptium automáticamente
JAVA_DOWNLOAD_URL=

# ==========================================
# AZURE AD - MICROSOFT AUTH (OPCIONAL)
# ==========================================
AZURE_CLIENT_ID=


# ==========================================
# AZURE AD - MICROSOFT AUTH (OPCIONAL)
# ==========================================
AZURE_CLIENT_ID=